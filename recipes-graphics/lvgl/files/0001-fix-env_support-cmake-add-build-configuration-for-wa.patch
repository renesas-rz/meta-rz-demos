From 4375038ae5d997617acef226fc6220c2a05e4006 Mon Sep 17 00:00:00 2001
From: Yoshihito Ogawa <yoshihito.ogawa.kc@renesas.com>
Date: Mon, 24 Aug 2026 16:55:46 +0900
Subject: [PATCH] fix(env_support/cmake): add build configuration for wayland

Signed-off-by: Yoshihito Ogawa <yoshihito.ogawa.kc@renesas.com>
---
 CMakeLists.txt                           |  1 +
 env_support/cmake/custom.cmake           | 42 ++++++++++++++++++++++++
 src/drivers/wayland/lv_wayland_private.h |  2 +-
 3 files changed, 44 insertions(+), 1 deletion(-)
 create mode 100644 env_support/cmake/custom.cmake

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 8a5e49d33..ea40abfa8 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -24,6 +24,7 @@ elseif(MICROPY_DIR)
   include(${CMAKE_CURRENT_LIST_DIR}/env_support/cmake/micropython.cmake)
 else()
   include(${CMAKE_CURRENT_LIST_DIR}/env_support/cmake/os_desktop.cmake)
+  include(${CMAKE_CURRENT_LIST_DIR}/env_support/cmake/custom.cmake)
 endif()
 
 #[[
diff --git a/env_support/cmake/custom.cmake b/env_support/cmake/custom.cmake
new file mode 100644
index 000000000..6210b1c35
--- /dev/null
+++ b/env_support/cmake/custom.cmake
@@ -0,0 +1,42 @@
+include("${CMAKE_CURRENT_LIST_DIR}/version.cmake")
+
+# Find wayland-scanner
+find_program(WAYLAND_SCANNER_EXECUTABLE wayland-scanner REQUIRED)
+
+# Find wayland-protocols
+find_package(PkgConfig)
+pkg_check_modules(WAYLAND_PROTOCOLS REQUIRED wayland-protocols)
+pkg_get_variable(WAYLAND_PROTOCOLS_PKGDATADIR wayland-protocols pkgdatadir)
+
+# Set a path to xdg-shell.xml
+set(XDG_SHELL_XML_PATH
+ "${WAYLAND_PROTOCOLS_PKGDATADIR}/stable/xdg-shell/xdg-shell.xml"
+  CACHE FILEPATH "Path to the xdg-shell.xml protocol definition")
+
+# Set paths to generated files
+set(XDG_SHELL_HEADER "${LVGL_ROOT_DIR}/src/drivers/wayland/wayland_xdg_shell.h")
+set(XDG_SHELL_CODE   "${LVGL_ROOT_DIR}/src/drivers/wayland/wayland_xdg_shell.c")
+
+# Generate a client header
+add_custom_command(
+  OUTPUT ${XDG_SHELL_HEADER}
+  COMMAND ${WAYLAND_SCANNER_EXECUTABLE} client-header ${XDG_SHELL_XML_PATH} ${XDG_SHELL_HEADER}
+  DEPENDS ${XDG_SHELL_XML_PATH}
+  COMMENT "Generating wayland_xdg_shell.h"
+)
+
+# Generate code
+add_custom_command(
+  OUTPUT ${XDG_SHELL_CODE}
+  COMMAND ${WAYLAND_SCANNER_EXECUTABLE} private-code ${XDG_SHELL_XML_PATH} ${XDG_SHELL_CODE}
+  DEPENDS ${XDG_SHELL_XML_PATH}
+  COMMENT "Generating wayland_xdg_shell.c"
+)
+
+# Mark files with the GENERATED property
+set_source_files_properties(${XDG_SHELL_HEADER} ${XDG_SHELL_CODE} PROPERTIES GENERATED TRUE)
+
+# Build a static library for the generated files
+add_library(lv_xdg_shell STATIC ${XDG_SHELL_HEADER} ${XDG_SHELL_CODE})
+
+target_link_libraries(lvgl PRIVATE lv_xdg_shell)
\ No newline at end of file
diff --git a/src/drivers/wayland/lv_wayland_private.h b/src/drivers/wayland/lv_wayland_private.h
index a84950c6d..3d99773e6 100644
--- a/src/drivers/wayland/lv_wayland_private.h
+++ b/src/drivers/wayland/lv_wayland_private.h
@@ -21,7 +21,7 @@ extern "C" {
 
 #include <sys/poll.h>
 #include <wayland-client-protocol.h>
-#include <wayland_xdg_shell.h>
+#include "wayland_xdg_shell.h"
 #include "../../misc/lv_types.h"
 #include "lv_wl_backend_private.h"
 
